MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
# AUTH_SECRET can be used instead of JWT_SECRET by existing deployments.
AUTH_SECRET=replace-with-the-same-long-random-secret

# Cloudinary (server-only: do not prefix these names with NEXT_PUBLIC_)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional existing integrations
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SYSTEM_USER_TOKEN=
WHATSAPP_API_WEBHOOK_TOKEN=
